#!/usr/bin/env python3
"""Run a command in this project's prepared test environment with your current changes.

Usage: ./swe-test <command...>    e.g. ./swe-test python -m pytest tests/test_x.py -x
Your edits (including new files) are applied to a clean copy of the original repository inside
the environment, then <command> runs from the repository root. Exit status is the command's.
"""
import json
import os
import shlex
import subprocess
import sys
import tempfile
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
IMAGE = "__IMAGE__"
EXCLUDE = __EXCLUDE__


def patch():
    spec = ["--", ".", *[f":(exclude){p}" for p in EXCLUDE]]
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, "GIT_INDEX_FILE": os.path.join(tmp, "index")}
        git = lambda *a: subprocess.run(["git", "-C", HERE, *a], env=env, capture_output=True, text=True)
        git("read-tree", "swe-base")
        git("add", "-A", *spec)
        return git("diff", "--cached", "--binary", "swe-base", *spec).stdout


if len(sys.argv) < 2:
    print(__doc__)
    sys.exit(2)
command = " ".join(shlex.quote(a) for a in sys.argv[1:]) if len(sys.argv) > 2 else sys.argv[1]
body = json.dumps({"image": IMAGE, "patch": patch(), "command": command, "timeout": 900}).encode()
request = urllib.request.Request("http://127.0.0.1:__PORT__/run", data=body,
                                 headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(request, timeout=1100) as response:
        result = json.loads(response.read())
except OSError as error:
    print(f"swe-test: test environment unreachable: {error}")
    sys.exit(125)
sys.stdout.write(result["output"])
sys.exit(result["exit"])
