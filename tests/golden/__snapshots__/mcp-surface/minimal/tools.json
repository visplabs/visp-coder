        },
        "subjectDigest": {
          "type": "string"
        },
        "captures": {},
        "selection": {
          "$ref": "#/properties/reviewer"
        },
        "response": {
          "$ref": "#/properties/reviewer"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template": {
          "type": "boolean"
        },
        "prepare": {
          "type": "boolean"
        },
        "session": {
