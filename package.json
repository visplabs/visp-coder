{
  "name": "@visporg/visp-coder",
  "version": "0.5.0-beta.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Harness for AI coding agents: an actor-critic loop with executed checks, bounded file scope, an independent reviewer and independent acceptance tests. CLI and MCP server.",
  "license": "Apache-2.0",
  "author": "Dineth Keshawa Jayathilaka",
  "homepage": "https://github.com/visplabs/visp-coder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visplabs/visp-coder.git"
  },
  "bugs": {
    "url": "https://github.com/visplabs/visp-coder/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "harness",
    "actor-critic",
    "code-review",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.3.0",
  "bin": {
    "visp": "dist/cli.js",
    "visp-migrate": "dist/migrate.js",
    "visp-runner": "dist/runner.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./graph": { "types": "./dist/graph.d.ts", "import": "./dist/graph.js", "default": "./dist/graph.js" },
    "./runner": { "types": "./dist/runner-api.d.ts", "import": "./dist/runner-api.js", "default": "./dist/runner-api.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js", "default": "./dist/testing.js" }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.ui.config.ts",
    "build:fast": "tsup --no-dts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "lint": "biome check src tests ui/src",
    "knip": "knip && knip --cycles",
    "format": "biome check --write src tests ui/src",
    "test": "vitest run",
    "test:unit": "pnpm build && vitest run tests/unit",
    "test:integration": "pnpm build && vitest run tests/integration",
    "test:functional": "vitest run tests/functional",
    "test:qualification": "node --test tests/qualification/*.test.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:trust": "vitest run --config vitest.trust-boundary.config.ts --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm build && pnpm test",
    "release:check": "pnpm check && pnpm test:browser && pnpm test:qualification && pnpm test:coverage:trust && pnpm test:package",
    "prepublishOnly": "pnpm release:check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "commander": "^12.1.0",
    "ignore": "^7.0.6",
    "yaml": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "knip": "^6.39.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
