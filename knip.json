{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,js}",
    "tests/compat/*.ts",
    "tests/unit/sdlc/support/fake-jira-server.mjs"
  ],
  "project": [
    "src/**/*.ts!",
    "tests/**/*.{ts,mjs}",
    "!tests/fixtures/**",
    "scripts/**/*.{mjs,js}"
  ],
  "ignoreBinaries": [
    "mkfifo",
    "pgrep",
    "secret-tool"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "cycles": "error"
  }
}
